# ============================================================
# globeman 根级 .gitignore
# 说明：frontend/ 与 backend/ 各自已有 .gitignore，已覆盖 node_modules/、
# target/、dist/、static/、*.log 等。本文件只管「根级」与「跨目录兜底」的垃圾。
# ============================================================

# ===== 操作系统垃圾 =====
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ===== 日志 =====
*.log
logs/

# ===== 本地 AI / CLI 工具残留（含本项目 .workbuddy/ 记忆，不应进版本库）=====
.workbuddy/

# ===== VS Code =====
# 整个 .vscode 不进版本库（含 tasks.json / keybindings.json）
# 本地照常使用：Ctrl+Shift+B 打开任务选择器，一键起前端 / 后端 / 前后端
.vscode/

# ===== 环境变量（敏感，防患未然；模板保留）=====
.env
.env.*
!.env.example

# ===== 跨目录兜底（子目录各自的 .gitignore 已覆盖，这里防止误建在根级）=====
node_modules/
target/
dist/
static/

# ===== 根级随手文件（运行/测试残留，不进版本库）=====
/restart

# ===== 后端用户上传图（backend/public/picture/ 动态生成，不进版本库）=====
backend/public/picture/
frontend/src/assets/1.jpg
frontend/src/assets/logo.jpg
