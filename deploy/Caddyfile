# ============================================================
# quanqiuren-web 前端部署 + /api 反向代理配置（Caddy 版）
# 作用：把浏览器发往 https://www.globeman.cn/api/xxx 的请求
#       转发到后端 :8080/xxx，并剥离 /api 前缀
#       与 Vite dev 代理的 rewrite(/^\/api/ -> '') 行为一致
# ============================================================

www.globeman.cn {
    # ---- /api 反代到后端 8080，并剥离 /api 前缀 ----
    # 例如 /api/login -> 后端收到 /login
    handle_path /api/* {
        # 后端与 Caddy 同机时：
        reverse_proxy 127.0.0.1:8080

        # 后端在另一台机时，注释上一行、取消下一行注释：
        # reverse_proxy 111.23.252.161:8080
    }

    # ---- 前端静态页（Vue history 模式路由） ----
    handle {
        root * /var/www/quanqiuren-web/static
        try_files {path} /index.html
        file_server
    }
}
